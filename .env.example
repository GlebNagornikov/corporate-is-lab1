SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=corporate_is
POSTGRES_USER=corporate_is
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
FRONTEND_HOST_PORT=5173
# Для прямых dev-запросов с другого порта перечислите точные origin через запятую.
# DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# для запуска manage.py с хоста, без Docker; внутри контейнера web переопределяется в docker-compose.yml
DATABASE_URL=postgres://corporate_is:change-me@localhost:5432/corporate_is
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO

# Отдельный секрет HMAC платёжного webhook; заменить случайным значением
PAYMENT_WEBHOOK_SECRET=change-me-payment-secret

REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_THROTTLE_URL=redis://redis:6379/2

SITE_URL=http://127.0.0.1:8000
